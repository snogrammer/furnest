# Example Caddy site for furnest. Replace furnest.example.com with your domain;
# Caddy fetches a TLS certificate for it automatically.
#
# Caddy must reach the web container. docker-compose.portainer.yml puts it on
# the shared `caddy_net` network as `furnest-web:8000`; a Caddy on the host
# uses 127.0.0.1:8000 (FURNEST_HOST_PORT) instead.
#
# In the stack's environment (see stack.env.example), set:
#   BASE_URL=https://furnest.example.com
#   WEB_TRUSTED_PROXIES=<caddy_net's exact subnet, e.g. 172.18.0.0/16>
# so login rate limiting sees the real client IP and HTTPS is detected. Every
# address in that range may set X-Forwarded-For, so keep it as narrow as you can.

furnest.example.com {
	encode zstd gzip

	# furnest leaves HSTS to the proxy, since only the proxy knows the site is
	# served over HTTPS. Drop includeSubDomains if a subdomain still serves HTTP.
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# No furnest request comes close to this (the largest form, an email
	# template, is ~20 KB). It keeps oversized bodies away from routes that read
	# them before checking auth, like /login and /discord/interactions.
	request_body {
		max_size 1MB
	}

	# /discord/interactions MUST stay reachable from the public internet: Discord
	# calls it for every button press, and every request is checked against the
	# application's Ed25519 public key. The dashboard is token-protected, but you
	# can also restrict it to trusted networks (VPN, LAN) by uncommenting this:
	#
	# @dashboard {
	# 	not path /discord/interactions /healthz
	# 	not remote_ip 192.0.2.0/24 2001:db8::/32
	# }
	# respond @dashboard 403

	reverse_proxy furnest-web:8000
}
