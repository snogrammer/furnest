# Environment for the Portainer stack (docker-compose.portainer.yml). Set these
# as the stack's environment variables in Portainer, which writes them to
# stack.env; or copy this file to stack.env to run the stack by hand.
# All values here are placeholders. .env.example lists every other setting.
# DATA_DIR, WEB_HOST and WEB_PORT are fixed by the compose file; don't set them here.

# --- Stack (used by the compose file itself) ----------------------------------
FURNEST_IMAGE=registry.example.com/example-org/furnest
FURNEST_TAG=latest
# Host directory for the SQLite database (the container takes ownership of it
# for uid 10001). Back this up.
FURNEST_DATA_PATH=/srv/furnest/data
# Existing Docker network shared with Caddy
SHARED_NETWORK=caddy_net
# Where the dashboard port is published on the host (0.0.0.0 for a remote proxy)
FURNEST_BIND_ADDR=127.0.0.1
FURNEST_HOST_PORT=8000

# --- App -----------------------------------------------------------------------
ENVIRONMENT=production
# Public URL Caddy serves the dashboard at
BASE_URL=https://furnest.example.com
TIMEZONE=UTC
# Caddy reaches furnest over SHARED_NETWORK; trust its subnet (find it with
# `docker network inspect caddy_net`).
WEB_TRUSTED_PROXIES=172.16.0.0/12

# --- Dashboard auth (secrets) --------------------------------------------------
# Generate each with e.g. `openssl rand -hex 32`.
AUTH_TOKEN=change-me-to-a-long-random-token
AUTH_SESSION_SECRET=change-me-to-another-long-random-secret
